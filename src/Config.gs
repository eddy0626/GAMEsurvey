    G05: ['시뮬레이션 · 육성', '방치형 · 캐주얼']        // 육성 시뮬
  };

  // ══════════════════════════════════════════════════════════════════════
  // 4. 이슈 플래그 임계값
  //    첫 테스트 후 조정한다. 한 게임에 플래그가 10개를 넘으면 느슨한 것이고
  //    2개 이하면 빡빡한 것이다.  (설계안 4장)
  // ══════════════════════════════════════════════════════════════════════
  var 임계값 = {
    육각평균_High:        3.0,   // 6축 항목 평균이 이 미만 → High
    육각평균_Critical:    2.5,   // 6축 항목 평균이 이 미만 → Critical
    부정선택지_High:      0.30,  // 부정 선택지 응답률 30% 이상 → High
    부정선택지_Critical:  0.50,  // 50% 이상 → Critical
    진행불가버그_건수:    1,     // '진행이 불가능할 정도' 1건 이상 → Critical
    지장버그_High:        0.20,  // '있었고 플레이에 지장' 20% 이상 → High
    튜토리얼어려움:       0.30,  // 튜토리얼 '어려움' 30% 이상 → Critical
    진행도정체:           0.25,  // 진행도가 튜토리얼 단계인 응답자 25% 이상 → Critical
    NPS비추천_High:       0.50,  // NPS 비추천(0~6점) 50% 이상 → High
    강점_평균:            4.0,   // 항목 평균 4.0 이상 → 강점
    검토필요_표준편차:    1.2,   // 표준편차 1.2 이상 → 검토 필요
    소수의견_비율:        0.20   // 개별 카드에서 '소수 의견' 표시를 붙일 응답률 기준
  };

  // ══════════════════════════════════════════════════════════════════════
  // 5. 드라이브 · 템플릿 · 시트 이름
  // ══════════════════════════════════════════════════════════════════════
  var 드라이브 = {
    루트폴더ID: '',        // 산출물 최상위 폴더. 비우면 마스터 시트가 있는 폴더를 쓴다.
    PDF도_같은폴더: true   // false 면 게임폴더/PDF 하위 폴더에 넣는다
  };

  var 템플릿 = {
    개별카드ID:   '',      // 구글 문서 '템플릿_개별카드' 의 ID (Phase 3에서 채운다)
    종합리포트ID: ''       // 구글 문서 '템플릿_종합리포트' 의 ID (Phase 4에서 채운다)
  };

  // 마스터 집계 시트 안의 탭 이름. '_' 로 시작하는 탭은 자동으로 숨긴다.
  var 시트 = {
    대시보드:   '대시보드',
    명부:       '_명부',        // 이름 ↔ ID ↔ 응답자 유형. 접근 제한을 걸 시트.
    집계_게임:   '_집계_게임',
    집계_문항:   '_집계_문항',
    집계_응답자: '_집계_응답자',
    플래그:     '_플래그',
    차트:       '_charts',
    실행로그:   '_실행로그'
  };

  // ══════════════════════════════════════════════════════════════════════
  // 6. 배치 처리 (Phase 5에서 사용)
  // ══════════════════════════════════════════════════════════════════════
  var 배치 = {
    묶음크기:       20,      // 한 번에 처리할 문서 건수
    자체중단_초:    300,     // 실행 시작 후 이 시간이 지나면 스스로 멈추고 트리거 예약 (6분 제한 대비)
    다음실행_지연분: 1       // 이어달리기 트리거를 몇 분 뒤에 걸 것인가
  };

  // ══════════════════════════════════════════════════════════════════════
  // 7. 차트 (Phase 2에서 사용)
  // ══════════════════════════════════════════════════════════════════════
  var 차트 = {
    폭: 520, 높이: 420,          // 레이더 차트 렌더 크기 (px)
    축최소: 0, 축최대: 5,        // 세로축 고정 — 게임 간 비교가 가능해야 한다
    색_전체평균: '#9AA6B2',
    색_본인:     '#1A73E8',
    색_게임:     '#1A73E8',
    재사용: true,                // 차트를 한 번 만들어 데이터만 바꿔 재사용한다.
                                 // 직전 응답자 그래프가 다시 나오는 등 이상하면 false 로 바꾼다.
                                 // 어느 쪽이 빠른지는 테스트_차트속도비교() 로 직접 잴 수 있다.
    고해상도URL사용: false       // true 로 두면 docs.google.com 내보내기 엔드포인트로
                                 // PNG 를 받는다. getAs() 가 서식을 뭉갤 때만 켠다.
                                 // (비공식 엔드포인트라 기본은 꺼 둔다)
  };

  // ══════════════════════════════════════════════════════════════════════
  // 8. 응답자 ID
  // ══════════════════════════════════════════════════════════════════════
  var 응답자 = {
    접두사: 'P',
    자리수: 2,                    // P01, P02 … (16명이면 2자리로 충분)
    유형: ['교육생', '전문가'],
    기본유형: '교육생',
    미상유형: '미상'
  };

  // ══════════════════════════════════════════════════════════════════════
  // 9. 대시보드
  // ══════════════════════════════════════════════════════════════════════
  var 대시보드 = {
    목표응답수: 0,      // 0 이면 _명부 에 등록된 인원 수를 목표로 본다 (교육생 14 + 전문가 2 = 16)
    미제출자표시: true  // 대시보드에 미제출자 이름을 띄운다.
                        // 담당자가 연락해야 하므로 여기만 실명을 쓴다.
                        // 카드 · 리포트 · PDF 등 산출물에는 절대 나가지 않는다.
  };

  return {
    GAMES: GAMES,
    공통문항: 공통문항,
    육각축: 육각축,
    추가축: 추가축,
    공통_부정선택지: 공통_부정선택지,
    진행도_정체단계: 진행도_정체단계,
    버그선택지: 버그선택지,
    구매선택지: 구매선택지,
    가격구간: 가격구간,
    게임_부정선택지: 게임_부정선택지,
    게임_튜토리얼문항: 게임_튜토리얼문항,
    체크박스문항: 체크박스문항,
    게임_문항유형: 게임_문항유형,
    게임_코어장르: 게임_코어장르,
    임계값: 임계값,
    드라이브: 드라이브,
    템플릿: 템플릿,
    시트: 시트,
    배치: 배치,
    차트: 차트,
    응답자: 응답자,
    대시보드: 대시보드,

    // 코드로 게임 설정 찾기
    게임찾기: function (코드) {
      for (var i = 0; i < GAMES.length; i++) if (GAMES[i].코드 === 코드) return GAMES[i];
      return null;
    }
  };
})();

// Node 테스트 하네스용. Apps Script 에서는 무시된다.
if (typeof module !== 'undefined') module.exports = { CONFIG: CONFIG };
